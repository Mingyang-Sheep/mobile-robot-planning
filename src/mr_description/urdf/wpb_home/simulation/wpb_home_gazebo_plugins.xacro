<?xml version="1.0"?>
<robot name="wpb_home_gazebo_plugins" xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    WPB Home upstream URDF has no left/right wheel joints. The hidden wheel
    links below are simulation-only drive joints for gazebo_ros_diff_drive.
    They do not replace or simplify the official visual mesh.
  -->
  <xacro:arg name="wheel_mu" default="1.0"/>
  <xacro:arg name="laser_visual" default="false"/>
  <xacro:arg name="camera_visual" default="false"/>
  <xacro:arg name="imu_visual" default="false"/>
  <xacro:arg name="enable_laser" default="true"/>
  <xacro:arg name="enable_camera" default="true"/>
  <xacro:arg name="enable_imu" default="true"/>

  <xacro:property name="wpb_wheel_radius" value="0.075"/>
  <xacro:property name="wpb_wheel_width" value="0.040"/>
  <xacro:property name="wpb_wheel_separation" value="0.460"/>
  <xacro:property name="wpb_caster_radius" value="0.030"/>

  <xacro:macro name="wpb_home_simulation_plugins" params="include_mani_joints:=false">
    <gazebo reference="body_link">
      <mu1>0.05</mu1>
      <mu2>0.05</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <material>Gazebo/White</material>
    </gazebo>

    <joint name="wpb_left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wpb_left_wheel_link"/>
      <origin xyz="0.0 0.230 0.065" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="wpb_left_wheel_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wpb_wheel_width}" radius="${wpb_wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.10"/>
        <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00008" iyz="0.0" izz="0.00014"/>
      </inertial>
    </link>

    <joint name="wpb_right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wpb_right_wheel_link"/>
      <origin xyz="0.0 -0.230 0.065" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="wpb_right_wheel_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wpb_wheel_width}" radius="${wpb_wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.10"/>
        <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00008" iyz="0.0" izz="0.00014"/>
      </inertial>
    </link>

    <gazebo reference="wpb_left_wheel_link">
      <mu1>$(arg wheel_mu)</mu1>
      <mu2>$(arg wheel_mu)</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo reference="wpb_right_wheel_link">
      <mu1>$(arg wheel_mu)</mu1>
      <mu2>$(arg wheel_mu)</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo>
      <plugin name="wpb_home_diff_drive" filename="libgazebo_ros_diff_drive.so">
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <odometrySource>world</odometrySource>
        <publishOdomTF>true</publishOdomTF>
        <robotBaseFrame>base_footprint</robotBaseFrame>
        <publishWheelTF>false</publishWheelTF>
        <publishTf>true</publishTf>
        <publishWheelJointState>true</publishWheelJointState>
        <legacyMode>false</legacyMode>
        <updateRate>30</updateRate>
        <leftJoint>wpb_left_wheel_joint</leftJoint>
        <rightJoint>wpb_right_wheel_joint</rightJoint>
        <wheelSeparation>${wpb_wheel_separation}</wheelSeparation>
        <wheelDiameter>${2 * wpb_wheel_radius}</wheelDiameter>
        <wheelAcceleration>1.0</wheelAcceleration>
        <wheelTorque>20.0</wheelTorque>
        <rosDebugLevel>na</rosDebugLevel>
      </plugin>
    </gazebo>

    <xacro:if value="${include_mani_joints}">
      <joint name="wpb_front_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="wpb_front_caster_link"/>
        <origin xyz="0.160 0.0 ${wpb_caster_radius}" rpy="0 0 0"/>
      </joint>

      <link name="wpb_front_caster_link">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${wpb_caster_radius}"/>
          </geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0"/>
          <mass value="0.02"/>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
      </link>

      <joint name="wpb_rear_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="wpb_rear_caster_link"/>
        <origin xyz="-0.160 0.0 ${wpb_caster_radius}" rpy="0 0 0"/>
      </joint>

      <link name="wpb_rear_caster_link">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${wpb_caster_radius}"/>
          </geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0"/>
          <mass value="0.02"/>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
      </link>

      <gazebo reference="wpb_front_caster_link">
        <mu1>0.02</mu1>
        <mu2>0.02</mu2>
        <kp>500000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
      </gazebo>

      <gazebo reference="wpb_rear_caster_link">
        <mu1>0.02</mu1>
        <mu2>0.02</mu2>
        <kp>500000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
      </gazebo>

      <gazebo>
        <plugin name="wpb_home_mani_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
          <jointName>mani_base, elbow_forearm, forearm_left_finger, forearm_right_finger</jointName>
          <updateRate>30.0</updateRate>
          <alwaysOn>true</alwaysOn>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg enable_laser)">
      <gazebo reference="laser">
        <sensor type="ray" name="wpb_home_rplidar_sensor">
          <pose>0 0 0.15 0 0 0</pose>
          <visualize>$(arg laser_visual)</visualize>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.24</min>
              <max>6.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="wpb_home_rplidar_controller" filename="libgazebo_ros_laser.so">
            <topicName>scan</topicName>
            <frameName>laser</frameName>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg enable_camera)">
      <gazebo reference="base_link">
        <sensor type="depth" name="wpb_home_rgbd_sensor">
          <pose>0.145 -0.013 1.37 0 0.5 0</pose>
          <always_on>true</always_on>
          <visualize>$(arg camera_visual)</visualize>
          <update_rate>15.0</update_rate>
          <camera name="wpb_home_rgbd_camera">
            <horizontal_fov>1.221730456</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.3</near>
              <far>6.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <plugin name="wpb_home_rgbd_controller" filename="libgazebo_ros_depth_camera.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>15.0</updateRate>
            <cameraName>camera</cameraName>
            <imageTopicName>rgb/image_raw</imageTopicName>
            <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
            <depthImageTopicName>depth/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
            <pointCloudTopicName>depth/points</pointCloudTopicName>
            <frameName>kinect2_rgb_optical_frame</frameName>
            <pointCloudCutoff>0.3</pointCloudCutoff>
            <pointCloudCutoffMax>6.0</pointCloudCutoffMax>
            <distortionK1>0.0</distortionK1>
            <distortionK2>0.0</distortionK2>
            <distortionK3>0.0</distortionK3>
            <distortionT1>0.0</distortionT1>
            <distortionT2>0.0</distortionT2>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg enable_imu)">
      <gazebo reference="body_link">
        <sensor name="wpb_home_imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <visualize>$(arg imu_visual)</visualize>
          <plugin filename="libgazebo_ros_imu_sensor.so" name="wpb_home_imu_plugin">
            <topicName>imu</topicName>
            <bodyName>body_link</bodyName>
            <updateRateHZ>100.0</updateRateHZ>
            <gaussianNoise>0.0</gaussianNoise>
            <xyzOffset>0 0 0</xyzOffset>
            <rpyOffset>0 0 0</rpyOffset>
            <frameName>body_link</frameName>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
