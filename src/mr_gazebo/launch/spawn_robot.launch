<launch>
  <arg name="stage" default="1"/>
  <arg name="world_name" default="$(find mr_gazebo)/worlds/stage_$(arg stage).world"/>
  <arg name="robot_model" default="burger"/>
  <arg name="robot_name" default="$(eval arg('robot_model') if arg('robot_model').startswith('turtlebot3_') else 'turtlebot3_' + arg('robot_model'))"/>

  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.01"/>
  <arg name="yaw" default="0.0"/>
  <arg name="wheel_mu" default="1.0"/>

  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>

  <env name="GAZEBO_MODEL_PATH" value="$(find mr_gazebo)/models:$(env HOME)/.gazebo/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <env name="GAZEBO_MODEL_DATABASE_URI" value=""/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <include file="$(find mr_description)/launch/load_robot_description.launch">
    <arg name="robot_model" value="$(arg robot_model)"/>
    <arg name="wheel_mu" value="$(arg wheel_mu)"/>
  </include>

  <!-- 裸车仿真同样需要基础 TF 树，否则 base_scan 等固定坐标系不会被发布。 -->
  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen">
    <param name="publish_frequency" value="30.0"/>
  </node>

  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_robot"
        if="$(eval float(arg('z')) >= 0.0)"
        args="-urdf
              -param robot_description
              -model $(arg robot_name)
              -x $(arg x)
              -y $(arg y)
              -z $(arg z)
              -Y $(arg yaw)"/>

  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_robot"
        if="$(eval float(arg('z')) &lt; 0.0)"
        args="-urdf
              -param robot_description
              -model $(arg robot_name)
              -x $(arg x)
              -y $(arg y)
              -z 0.0
              -Y $(arg yaw)"/>
</launch>
