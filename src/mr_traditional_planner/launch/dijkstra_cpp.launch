<launch>
  <!-- Dijkstra C++ plugin：/map + /move_base_simple/goal -> /mr_traditional_planner/optimal_path -->
  <node pkg="mr_traditional_planner" type="planner_plugin_node" name="dijkstra_planner_cpp" output="screen">
    <param name="planner_plugin" value="mr_traditional_planner/DijkstraPlanner"/>
  </node>
</launch>
