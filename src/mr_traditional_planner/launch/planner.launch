<launch>
  <!-- 统一切换入口：C++ 通过 pluginlib 参数加载，Python 保持脚本入口兼容。 -->
  <arg name="algorithm" default="astar"/>
  <arg name="impl" default="cpp"/>
  <arg name="planner_plugin" default=""/>

  <group if="$(eval arg('impl') == 'cpp')">
    <node pkg="mr_traditional_planner" type="planner_plugin_node" name="planner_plugin_node" output="screen">
      <param name="algorithm" value="$(arg algorithm)"/>
      <param name="planner_plugin" value="$(arg planner_plugin)"/>
    </node>
  </group>

  <include if="$(eval arg('algorithm') == 'astar' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/astar_py.launch"/>

  <include if="$(eval arg('algorithm') == 'dijkstra' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/dijkstra_py.launch"/>
  <include if="$(eval arg('algorithm') == 'dstar' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/dstar_py.launch"/>
  <include if="$(eval arg('algorithm') == 'dstar_lite' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/dstar_lite_py.launch"/>
  <include if="$(eval arg('algorithm') == 'theta_star' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/theta_star_py.launch"/>
  <include if="$(eval arg('algorithm') == 'rrt_star' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/rrt_star_py.launch"/>
  <include if="$(eval arg('algorithm') == 'dwa' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/dwa_py.launch"/>
  <include if="$(eval arg('algorithm') == 'cubic_spline' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/cubic_spline_py.launch"/>

  <include if="$(eval arg('algorithm') == 'bcd' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/bcd_py.launch"/>

  <include if="$(eval arg('algorithm') == 'stc' and arg('impl') == 'py')"
           file="$(find mr_traditional_planner)/launch/stc_py.launch"/>
</launch>
