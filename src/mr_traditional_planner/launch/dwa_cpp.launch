<launch>
  <!-- DWA C++ plugin: /map + /odom + /move_base_simple/goal -> /cmd_vel and /mr_traditional_planner/optimal_path -->
  <node pkg="mr_traditional_planner" type="planner_plugin_node" name="dwa_planner_cpp" output="screen">
    <param name="planner_plugin" value="mr_traditional_planner/DynamicWindowApproachPlanner"/>
  </node>
</launch>
