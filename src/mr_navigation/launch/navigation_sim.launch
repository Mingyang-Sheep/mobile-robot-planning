<launch>
  <!-- 总入口：一条命令同时启动 Gazebo 世界、地图、AMCL 和 move_base。 -->
  <arg name="model" default="burger"/>
  <arg name="robot_model" default="$(arg model)"/>
  <arg name="map_name" default="turtlebot3_world"/>
  <arg name="world_name" default="$(find mr_gazebo)/worlds/turtlebot3_world.world"/>

  <!-- 默认可验证配对：world_name=turtlebot3_world.world, map_name=turtlebot3_world。 -->
  <arg name="robot_name" default="$(eval arg('robot_model') if arg('robot_model').startswith('turtlebot3_') or arg('robot_model').startswith('wpb_home') else 'turtlebot3_' + arg('robot_model'))"/>
  <arg name="x" default="-2.0"/>
  <arg name="y" default="-0.5"/>
  <arg name="z" default="0.01"/>
  <arg name="yaw" default="0.0"/>
  <arg name="wheel_mu" default="1.0"/>
  <arg name="laser_visual" default="false"/>
  <arg name="camera_visual" default="false"/>
  <arg name="imu_visual" default="false"/>
  <arg name="enable_laser" default="true"/>
  <arg name="enable_camera" default="true"/>
  <arg name="enable_imu" default="true"/>

  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="use_navigation" default="true"/>
  <arg name="use_rviz" default="true"/>

  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="move_forward_only" default="false"/>
  <arg name="planning_mode" default="normal"/>
  <arg name="global_planner" default="navfn"/>
  <arg name="path_smoother" default="none"/>
  <arg name="local_planner" default="dwa"/>
  <arg name="coverage_planner" default="stc"/>
  <arg name="costmap_cost_weight" default="2.0"/>
  <arg name="base_global_planner" default=""/>
  <arg name="base_local_planner" default=""/>

  <!-- 先拉起与地图一一对应的官方导航仿真世界。 -->
  <include file="$(find mr_gazebo)/launch/spawn_navigation_world.launch">
    <arg name="robot_model" value="$(arg robot_model)"/>
    <arg name="robot_name" value="$(arg robot_name)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <arg name="wheel_mu" value="$(arg wheel_mu)"/>
    <arg name="laser_visual" value="$(arg laser_visual)"/>
    <arg name="camera_visual" value="$(arg camera_visual)"/>
    <arg name="imu_visual" value="$(arg imu_visual)"/>
    <arg name="enable_laser" value="$(arg enable_laser)"/>
    <arg name="enable_camera" value="$(arg enable_camera)"/>
    <arg name="enable_imu" value="$(arg enable_imu)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <!-- 再启动地图、定位与导航栈，默认初始位姿与仿真出生点保持一致。 -->
  <include file="$(find mr_navigation)/launch/navigation.launch" if="$(arg use_navigation)">
    <arg name="model" value="$(arg model)"/>
    <arg name="robot_model" value="$(arg robot_model)"/>
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <arg name="move_forward_only" value="$(arg move_forward_only)"/>
    <arg name="planning_mode" value="$(arg planning_mode)"/>
    <arg name="global_planner" value="$(arg global_planner)"/>
    <arg name="path_smoother" value="$(arg path_smoother)"/>
    <arg name="local_planner" value="$(arg local_planner)"/>
    <arg name="coverage_planner" value="$(arg coverage_planner)"/>
    <arg name="costmap_cost_weight" value="$(arg costmap_cost_weight)"/>
    <arg name="base_global_planner" value="$(arg base_global_planner)"/>
    <arg name="base_local_planner" value="$(arg base_local_planner)"/>
    <arg name="initial_pose_x" value="$(arg x)"/>
    <arg name="initial_pose_y" value="$(arg y)"/>
    <arg name="initial_pose_a" value="$(arg yaw)"/>
  </include>

  <node pkg="rviz" type="rviz" name="rviz" required="true" if="$(arg use_rviz)"
        args="-d $(find mr_navigation)/rviz/navigation.rviz"/>
</launch>
