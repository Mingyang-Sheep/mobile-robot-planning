<launch>
  <!-- model 只负责选择底盘专有参数文件，通用环境参数保持不变。 -->
  <arg name="model" default="burger"/>
  <arg name="robot_model" default="$(arg model)"/>
  <arg name="model_key" default="$(eval arg('robot_model').replace('turtlebot3_', '', 1) if arg('robot_model').startswith('turtlebot3_') else arg('robot_model'))"/>
  <arg name="nav_model_key" default="$(eval 'wpb_home' if arg('model_key') == 'wpb_home_mani' else arg('model_key'))"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="move_forward_only" default="false"/>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <!-- 专有参数按 robot_model 动态拼接，后续新增底盘只需补同名 yaml。 -->
    <rosparam file="$(find mr_navigation)/config/costmap_common_params_$(arg nav_model_key).yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find mr_navigation)/config/costmap_common_params_$(arg nav_model_key).yaml" command="load" ns="local_costmap"/>
    <!-- 通用环境参数不绑定任何底盘型号，所有机器人共用同一套基础导航行为。 -->
    <rosparam file="$(find mr_navigation)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find mr_navigation)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find mr_navigation)/config/move_base_params.yaml" command="load"/>
    <!-- WPB Home 对局部窗口和控制耐心值略有调整；TurtleBot3 保持原通用参数。 -->
    <rosparam file="$(find mr_navigation)/config/local_costmap_params_wpb_home.yaml" command="load" if="$(eval arg('nav_model_key') == 'wpb_home')"/>
    <rosparam file="$(find mr_navigation)/config/global_costmap_params_wpb_home.yaml" command="load" if="$(eval arg('nav_model_key') == 'wpb_home')"/>
    <rosparam file="$(find mr_navigation)/config/move_base_params_wpb_home.yaml" command="load" if="$(eval arg('nav_model_key') == 'wpb_home')"/>
    <rosparam file="$(find mr_navigation)/config/dwa_local_planner_params_$(arg nav_model_key).yaml" command="load"/>

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>

    <param name="DWAPlannerROS/min_vel_x" value="0.0" if="$(arg move_forward_only)"/>
  </node>
</launch>
