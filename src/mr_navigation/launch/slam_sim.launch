<launch>
  <!-- Navigation package convenience wrapper for the shared SLAM simulation entry. -->
  <arg name="slam_method" default="gmapping"/>
  <arg name="model" default="burger"/>
  <arg name="robot_model" default="$(arg model)"/>
  <arg name="stage" default="1"/>
  <arg name="world_name" default="$(find mr_gazebo)/worlds/stage_$(arg stage).world"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.01"/>
  <arg name="yaw" default="0.0"/>
  <arg name="wheel_mu" default="1.0"/>
  <arg name="laser_visual" default="false"/>
  <arg name="camera_visual" default="false"/>
  <arg name="imu_visual" default="false"/>
  <arg name="enable_laser" default="true"/>
  <arg name="enable_camera" default="true"/>
  <arg name="enable_imu" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_rviz" default="true"/>
  <arg name="rviz_config" default="$(find mr_slam)/rviz/slam.rviz"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom"/>

  <include file="$(find mr_slam)/launch/slam_sim.launch">
    <arg name="slam_method" value="$(arg slam_method)"/>
    <arg name="model" value="$(arg model)"/>
    <arg name="robot_model" value="$(arg robot_model)"/>
    <arg name="stage" value="$(arg stage)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <arg name="wheel_mu" value="$(arg wheel_mu)"/>
    <arg name="laser_visual" value="$(arg laser_visual)"/>
    <arg name="camera_visual" value="$(arg camera_visual)"/>
    <arg name="imu_visual" value="$(arg imu_visual)"/>
    <arg name="enable_laser" value="$(arg enable_laser)"/>
    <arg name="enable_camera" value="$(arg enable_camera)"/>
    <arg name="enable_imu" value="$(arg enable_imu)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
  </include>
</launch>
